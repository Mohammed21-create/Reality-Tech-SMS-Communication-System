# ---- Core ----
NODE_ENV=development
PORT=3000
# Public URL of the app (used to show webhook URLs to schools)
BASE_URL=http://localhost:3000
# Number of reverse-proxy hops in front of the app (Render = 1)
TRUST_PROXY=1

# ---- MongoDB (Atlas) ----
MONGODB_URI=mongodb://127.0.0.1:27017/reality_tech_sms
MONGO_MAX_POOL_SIZE=20

# ---- Redis / Render Key Value (BullMQ + rate limits) ----
REDIS_URL=redis://127.0.0.1:6379

# ---- Secrets ----
# 32 random bytes as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to encrypt each school's SMS provider credentials. NEVER commit or change
# without re-encrypting stored credentials.
ENCRYPTION_KEY=

# ---- Sessions / auth ----
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
BCRYPT_ROUNDS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---- SMS processing ----
SMS_BATCH_SIZE=100                # recipients per provider call
SMS_SEND_CONCURRENCY=5            # parallel batches per worker instance
SMS_PER_SCHOOL_MAX_INFLIGHT=2     # fairness: max concurrent batches per school
SMS_QUEUE_BACKLOG_LIMIT=200       # max jobs waiting in the send queue
SMS_MAX_ATTEMPTS=5                # BullMQ attempts for temporary failures
DLR_MIN_AGE_SECONDS=45            # wait before polling provider for delivery status
ALLOW_MOCK_PROVIDER=true          # mock provider (set false in production)
ARKESEL_MAX_PER_SECOND=50
ARKESEL_SEND_CALLBACK=false       # include callback_url in send requests (see README)
DEFAULT_COUNTRY=GH

# ---- Imports ----
MAX_IMPORT_MB=10
MAX_IMPORT_ROWS=50000

# ---- Bootstrap super admin (used by: npm run seed:superadmin) ----
SUPER_ADMIN_EMAIL=admin@realitytech.com
SUPER_ADMIN_NAME=Reality Tech Admin
# Leave empty to generate a random password that is printed once.
SUPER_ADMIN_PASSWORD=
